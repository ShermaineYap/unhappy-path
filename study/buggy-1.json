    {
      "id": "declined-capture",
      "headline": "The merchant marked a declined payment as paid and fulfilled it.",
      "rootCause": "PayPal order is APPROVED (never captured). Merchant /approve answered 200; merchant now says paid, fulfilled ×1.",
      "impact": "You ship goods for payments that never arrived.",
      "fix": {
        "language": "ts",
        "code": "const r = await capture(orderId);\nconst cap = r.purchase_units?.[0]?.payments?.captures?.[0];\nif (!r.ok || cap?.status !== \"COMPLETED\") {\n  await db.orders.update(orderId, { status: \"failed\" });\n  return res.status(402).json({ retry: true }); // let buyer pick another funding source\n}\nawait fulfilOnce(orderId);"
      },
      "citations": [
        {
          "id": "orders-capture",
          "title": "Orders v2: capture payment for order",
          "url": "https://developer.paypal.com/docs/api/orders/v2/#orders_capture"
        },
        {
          "id": "decline-handling",
          "title": "Handle funding failures (INSTRUMENT_DECLINED)",
