    {
      "id": "price-tampering",
      "headline": "The merchant created a PayPal order for 0.01 instead of 25.00.",
      "rootCause": "Normal checkout → PayPal order for 25.00. Tampered checkout → PayPal order for 0.01.",
      "impact": "Anyone can edit the request in their browser and buy your products for 1 cent.",
      "fix": {
        "language": "ts",
        "code": "// Server: price comes from YOUR catalog, never from the request body\nconst item = CATALOG[body.sku];\nconst value = (Number(item.price) * qty).toFixed(2);\nawait paypal.orders.create({ intent: \"CAPTURE\",\n  purchase_units: [{ amount: { currency_code: \"USD\", value } }] });"
      },
      "citations": [
        {
          "id": "orders-create",
          "title": "Orders v2: create order",
          "url": "https://developer.paypal.com/docs/api/orders/v2/#orders_create"
        }
      ],
      "toolCalls": [
